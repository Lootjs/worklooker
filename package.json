{
  "name": "worklooker",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "collect": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "build": "vite build",
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "start": "tsx src/server.ts",
    "telegram:login": "tsx src/telegram-login.ts",
    "mcp:playwright": "playwright-mcp --output-dir .playwright-mcp"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "^1.58.0",
    "teleproto": "^1.233.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.85",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
